{
    "name": "Maa_SLIMEIM",
    "url": "https://github.com/miaojiuqing/SLIMEIM_Maa",
    "mirrorchyan_rid": "SLIMEIM_Maa",
    "mirrorchyan_multiplatform": false,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb"
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        }
    ],
    "task": [
        {
            "name": "进入游戏并打开菜单",
            "entry": "进入游戏并打开菜单",
            "doc": "**启动游戏**：\n\n自动登录并领取进游戏所有签到奖励\n\n**注意：英桀杯和武勇祭结算不会自动确认**\n\n- 若该任务运行过久那应该是游戏的超绝优化发力了，请自行重启游戏或模拟器"
        },
        {
            "name": "日常-送上礼物",
            "entry": "每日任务之喂食角色-开始任务层",
            "doc": "固定点击第三列第三位角色,如果你满好感度角色有大于等于9位的话请联系作者增加功能"
        },
        {
            "name": "日常-城镇对话",
            "entry": "每日任务之好感度对话-开始任务层"
        },
        {
            "name": "日常-建筑支援请求",
            "entry": "日常任务之请求建筑支援"
        },
        {
            "name": "日常-锻造场升级装备",
            "entry": "锻造场升级任务"
        },
        {
            "name": "日常-捕食战",
            "entry": "每日任务之捕食战",
            "option": [
                "选择捕食类型(默认转魂)"
            ],
            "doc": "可自由选择捕食类型,默认捕食类型为转魂\n\n![loading...](https://s21.ax1x.com/2025/06/15/pVAI1z9.png)\n\n不知道什么类型长啥样的看图"
        },
        {
            "name": "日常-领取任务奖励",
            "entry": "进入任务领取界面",
            "doc": "✨把这个任务添加三遍好像可以领取三个界面的任务）？"
        },
        {
            "name": "活动-并列演算20次",
            "entry": "版本活动限定-每日并列演算",
            "option": [
                "并列演算-选择用来并列演算的队伍"
            ],
            "doc": "使用前请确保自己已解锁可以并列演算的关卡\n 请在高级设置中自选自己最高收集特殊效果的编队"
        },
        {
            "name": "活动-活动捕食战每天3次",
            "entry": "活动期间捕食战-总任务层",
            "option": [
                "活动捕食战-选择用来并列演算的队伍"
            ],
            "doc": "自己过一下剧情\n\n现在新版本的还没开，用不了哦\n\n默认第九编队"
        },
        {
            "name": "琐事-生产资源统一领取",
            "entry": "统一回收总任务-开始任务层"
        },
        {
            "name": "琐事-泡温泉领体力",
            "entry": "泡温泉领体力-开始任务-是否处于主页"
        },
        {
            "name": "琐事-进联盟签到领奖励",
            "entry": "每日点一下盟主联合-开始任务层"
        },
        {
            "name": "琐事-领取邮箱奖励",
            "entry": "邮箱领取-开始任务层"
        },
        {
            "name": "琐事-一并支援奖励领取",
            "entry": "一并支援奖励领取-开始任务层"
        },
        {
            "name": "活动-自动翻牌",
            "entry": "活动限定-自动翻牌总任务",
            "doc": "可能会会选择到一些不好的道具,虽然优先选择的是上面的道具但是因为超级优化可能会选到一些不好的道具,不会选地图,因为我没截到,下版本再加"
        },
        {
            "name": "自动英桀杯一般战战斗-公式化战斗逻辑",
            "entry": "点击进入英桀杯",
            "doc": "此任务仅支持公式化战斗逻辑\n\n 公式化战斗逻辑配队:\n\n![loading...](https://s21.ax1x.com/2025/06/15/pVAIVrq.png)\n\n  [size:15][color:tomato]请先自己提前调整为手动战斗状态,自动切换战斗状态以后再说[/color][/size]\n 阴阳萌自己放在该放的地方,考虑到风露米有三转技能,请将主C放于5号位,三转工具人6号位"
        },
        {
            "name": "梦幻镜魔境-单层刷直到没体力",
            "entry": "梦幻镜魔境-任务总层",
            "doc": "此任务暂时只会在一个层里一直刷下去直到没体力,不考虑切换队伍和战斗失败的情况,有问题跟作者说作者改\n\n 未来考虑增加一个专门刷55层土豆精的高效率资源模式 \n\n[size:20][color:blue]非老登/摆子不建议勾选，最好手动领宝箱[/color][/size]"
        },
        {
            "name": "建议单独运行任务-自动主线",
            "entry": "自动主线-点击故事后-寻找指定章节",
            "option": [
                "选择你要打的章节\n\n(不考虑战斗失败情况)"
            ]
        },
        {
            "name": "建议单独运行任务-单副本一直刷",
            "entry": "单副本一直刷",
            "doc": "请在编队界面或正在打的时候开启此任务\n\n默认不吃药，若选择一直吃药记得手动关停，我体力药太多了，不知道吃完会发生什么",
            "option": [
                "若体力耗尽了，你选择？"
            ]
        }
