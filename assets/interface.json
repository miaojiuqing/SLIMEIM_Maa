{
    "name": "Maa_SLIMEIM",
    "url": "https://github.com/miaojiuqing/SLIMEIM_Maa",
    "mirrorchyan_rid": "SLIMEIM_Maa",
    "mirrorchyan_multiplatform": false,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb"
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        }
    ],
    "task": [
        {
            "name": "进入游戏并打开菜单",
            "entry": "进入游戏并打开菜单",
            "doc": "**启动游戏**：\n\n自动登录并领取进游戏所有签到奖励\n\n**注意：英桀杯和武勇祭结算会自动确认**\n\n- 若该任务运行过久那应该是游戏的超绝优化发力了，请自行重启游戏或模拟器\n\nm的狗币万代什么勾石优化最近黑屏能黑几分钟"
        },
        {
            "name": "日常-送上礼物",
            "entry": "每日任务之喂食角色-开始任务层",
            "doc": "固定点击第三列第三位角色,如果你满好感度角色有大于等于9位的话请联系作者增加功能"
        },
        {
            "name": "日常-城镇对话",
            "entry": "每日任务之好感度对话-开始任务层"
        },
        {
            "name": "日常-建筑支援请求",
            "entry": "日常任务之请求建筑支援"
        },
        {
            "name": "日常-锻造场升级装备",
            "entry": "锻造场升级任务"
        },
        {
            "name": "日常-捕食战",
            "entry": "每日任务之捕食战-开始任务层",
            "option": [
                "选择捕食类型(默认转魂)",
                "日常捕食战-选择战斗队伍"
            ],
            "doc": "可自由选择捕食类型,默认捕食类型为转魂\n\n![loading...](https://s21.ax1x.com/2025/06/15/pVAI1z9.png)\n\n不知道什么类型长啥样的看图"
        },
        {
            "name": "日常-领取任务奖励",
            "entry": "任务奖励领取-开始任务层",
            "doc": "✨把这个任务添加三遍好像可以领取三个界面的任务）？"
        },
        {
            "name": "活动-并列演算20次",
            "entry": "版本活动限定-每日并列演算-开始任务层",
            "option": [
                "并列演算-选择用来并列演算的队伍"
            ],
            "doc": "使用前请确保自己已解锁可以并列演算的关卡\n 请在高级设置中自选自己最高收集特殊效果的编队"
        },
        {
            "name": "活动-活动捕食战每天3次",
            "entry": "活动期间捕食战-总任务层",
