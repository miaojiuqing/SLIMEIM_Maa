                    "pipeline_override": {
                        "已切换至第七编队": {
                            "expected": [
                                "六",
                                "第六編隊"
                            ]
                        }
                    }
                },
                {
                    "name": "第七编队",
                    "pipeline_override": {
                        "已切换至第七编队": {
                            "expected": [
                                "七",
                                "第七編隊"
                            ]
                        }
                    }
                },
                {
                    "name": "第八编队",
                    "pipeline_override": {
                        "已切换至第七编队": {
                            "expected": [
                                "八",
