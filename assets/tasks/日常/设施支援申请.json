{
    "task": [
        {
            "name": "日常-设施支援",
            "label": "⛩️设施支援",
            "group": [
                "日常"
            ],
            "default_check": true,
            "entry": "设施支援-任务开始层",
            "description": "可以顺便把支援请求收了",
            //感觉可应该考虑一下智能支援之后万一有建筑完成了要怎么办
            "option": [
                "建国-通用-自动开启免费建筑栏",
                // "日常-设施支援-是否顺便收取支援申请奖励",
                "日常-设施支援-申请支援方式",
                "日常-设施支援-是否顺便收取设施产出奖励",
                //筛选（公共链，与盖德监工共用）
                "建国-通用-筛选-是否启用"
            ],
            "pipeline_override": {
                "异常处理-日期更新": {
                    "next": [
                        "设施支援-任务开始层"
                    ]
                }
            }
        }
    ],
    "option": {
        "建国-通用-自动开启免费建筑栏": {
            "label": "自动开启免费建筑栏",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "建国-通用-有免费建筑栏氪开启": {
                            "enabled": true
                        },
                        "建国-通用-免费栏目-解锁确认": {
                            "next": [
                                "设施支援-已进入建国界面",
                                "建国-通用-免费栏目-解锁确认"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "建国-通用-有免费建筑栏氪开启": {
                            "enabled": false
                        },
                        "建国-通用-免费栏目-解锁确认": {
                            "next": []
                        }
                    }
                }
            ]
        },
        "日常-设施支援-申请支援方式": {
            "label": "申请支援方式",
            "type": "select",
            "default_case": "日常-设施支援申请方式-单个加号",
            "cases": [
                {
                    "name": "日常-设施支援申请方式-单个加号",
                    "label": "单个加号",
                    "description": "直接点一下可识别范围内的加号",
                    "pipeline_override": {
                        "设施支援-有可申请支援的设施": {
                            "next": [
                                "设施支援-支援状态-支援申请成功",
                                "设施支援-支援状态-可送出支援",
                                "[JumpBack]设施支援-有可申请支援的设施-点击加号",
                                "[JumpBack]通用-可处理范围加载等待"
                            ]
                        }
                    }
                },
                {
                    "name": "日常-设施支援申请方式-智能推荐",
                    "label": "智能推荐",
                    "description": "非脚本内置功能,而是直接点击游戏内\"智能\"按钮",
                    "pipeline_override": {
                        "设施支援-有可申请支援的设施": {
                            "next": [
                                "设施支援-支援状态-支援申请成功",
                                "设施支援-支援状态-可送出支援",
                                "[JumpBack]设施支援-有可申请支援的设施-点击推荐",
                                "[JumpBack]通用-可处理范围加载等待"
                            ]
                        }
                    }
                }
            ]
        },
        "日常-设施支援-是否顺便收取设施产出奖励": {
            "type": "switch",
            "label": "顺便收取设施产出",
            "description": "只有检查到MAX了才会收取",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "设施支援-设施产出已达上限": {
                            "enabled": true
                        },
                        "设施产出领取-生产物品合计确认": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "设施支援-设施产出已达上限": {
                            "enabled": false
                        },
                        "设施产出领取-生产物品合计确认": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
