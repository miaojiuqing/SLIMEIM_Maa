{
    "task": [
        {
            "name": "日常-城镇对话",
            "entry": "日常-城镇对话-任务开始层",
            "label": "城镇对话",
            "group": [
                "日常"
            ],
            "default_check": true,
            "description": "还没做正常的每日好感度对话,旧版给我做掉了；没做交货时体力材料不足的处理,有需求请反馈",
            "option": [
                "日常-城镇对话-自动处理战斗事件",
                "日常-城镇对话-自动处理交货事件"
            ],
            "pipeline_override": {
                "异常处理-日期更新": {
                    "next": [
                        "日常-城镇对话-任务开始层"
                    ]
                }
            }
        }
    ],
    "option": {
        "日常-城镇对话-自动处理战斗事件": {
            "type": "switch",
            "label": "自动处理战斗事件",
            "icon": "./resource/image/繁中/日常/城镇对话/特殊事件/双一览界面/战斗.png",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "日常-城镇对话-双一览处-有可处理事件-战斗": {
                            "enabled": true
                        },
                        "日常-城镇对话-城镇内-有可处理事件-战斗": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "日常-城镇对话-战斗-编队切换",
                        "通用-编队切换方式"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "日常-城镇对话-双一览处-有可处理事件-战斗": {
                            "enabled": false
                        },
                        "日常-城镇对话-城镇内-有可处理事件-战斗": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "日常-城镇对话-自动处理交货事件": {
            "type": "switch",
            "label": "自动处理交货事件",
            "icon": "./resource/image/繁中/日常/城镇对话/特殊事件/双一览界面/交货.png",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "日常-城镇对话-双一览处-有可处理事件-交货": {
                            "enabled": true
                        },
                        "日常-城镇对话-城镇内-有可处理事件-交货": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "日常-城镇对话-双一览处-有可处理事件-交货": {
                            "enabled": false
                        },
                        "日常-城镇对话-城镇内-有可处理事件-交货": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
