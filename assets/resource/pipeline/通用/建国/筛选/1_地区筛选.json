{
    // ===== 地区段骨架 =====
    // 开始层 → 「地區」标题可见（=滑到最上）→ 5 个地区子项 → 筛选完了
    // 判据不成立时才轮到滑动动作，滑完 [JumpBack] 回开始层重判。
    "建国-通用-筛选-地区筛选-开始层": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": "DirectHit",
        "max_hit": 1,
        "focus": {
            "Node.Recognition.Succeeded": "开始地区筛选"
        },
        "next": [
            "建国-通用-筛选-地区筛选",
            "[JumpBack]建国-通用-筛选-地区筛选-滑动动作"
        ]
    },
    // 「地區限定」标题：面板滑到最上时才出现在 [65,142,174,67]。
    // 不再用 ALL 判断，因为地区多起来以后 ALL 会被顶到屏幕外。
    "建国-通用-筛选-地区筛选": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    65,
                    142,
                    174,
                    67
                ],
                "template": [
                    "通用/建国/筛选/地区/已处于地区限定.png"
                ],
                "threshold": 0.85
            }
        },
        "next": [
            "建国-通用-筛选-地区筛选-竹林-开始层",
            "建国-通用-筛选-地区筛选-观光-开始层",
            "建国-通用-筛选-地区筛选-结晶-开始层",
            "建国-通用-筛选-地区筛选-猶拉瑟尼亞-开始层",
            "建国-通用-筛选-地区筛选-海渊-开始层",
            "建国-通用-筛选-地区筛选-筛选完了"
        ]
    },
