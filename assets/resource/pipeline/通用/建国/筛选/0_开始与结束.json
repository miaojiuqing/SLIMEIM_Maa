{
    // ===== 入口层 =====
    // max_hit:1 让整条筛选链在一次任务里只跑一遍。
    // 链跑完后控制权回到调用方（设施支援 / 盖德监工的入口壳），
    // 入口壳重扫 next，本节点 max_hit 已耗尽 → 落到各家的「筛选完了」。
    "建国-通用-筛选-入口层": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": "DirectHit",
        "max_hit": 1,
        "focus": {
            "Node.Recognition.Succeeded": "已启用筛选功能,将开始筛选"
        },
        "next": [
            "建国-通用-筛选-打开筛选面板层"
        ]
    },
    // 打开面板：先看面板开没开，没开才去点入口按钮。
    "建国-通用-筛选-打开筛选面板层": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": "DirectHit",
        "next": [
            "建国-通用-筛选-已进入筛选界面",
            "建国-通用-筛选-点击筛选入口"
        ]
    },
    // 入口按钮：普通态（放大镜+横线）和残留态（带 ON 绿框）都要能点到。
    "建国-通用-筛选-点击筛选入口": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1118,
                    65,
                    126,
                    111
                ],
                "template": [
                    "通用/建国/提升/筛选入口.png",
                    "通用/建国/提升/已筛选.png"
                ],
                "threshold": 0.85
            }
        },
        "action": "Click",
        // 点完等面板弹出动画，免得「已进入筛选界面」在动画中途识别失败、
        // 而入口按钮又已被面板盖住，两路全灭导致漏出整条链。
        "post_delay": 300,
        "next": [
            "建国-通用-筛选-已进入筛选界面",
            "建国-通用-筛选-点击筛选入口"
        ]
    },
    // 面板已打开（顶部「篩選 & 排序」标题）。
    "建国-通用-筛选-已进入筛选界面": {
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    556,
                    54,
                    162,
                    83
                ],
                "template": [
                    "通用/建国/兴建/筛选界面.png"
                ],
                "threshold": 0.85
            }
        },
        "pre_delay": 300,
        "next": [
            "建国-通用-筛选-重置层-按住红色尝试变白",
            "建国-通用-筛选-重置层-成功变白重置成功_松手"
        ]
    },
    // ===== 重置层 =====
    // 重置按钮平时是暗红，按住变白。识别到暗红才按住，按住 1 秒后判白。
    // 没变白 = 没按上，就不松手、再按一次（自引用重试，不强制触开）。
    "建国-通用-筛选-重置层-按住红色尝试变白": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    71,
                    568,
                    255,
                    94
                ],
                "upper": [
                    165,
                    39,
                    72
                ],
                "lower": [
                    75,
                    8,
                    40
                ],
                "connected": true,
                "count": 8500
            }
        },
        "action": {
            "type": "TouchDown",
            "param": {
                "target": [
                    94,
                    592,
                    197,
                    50
                ]
            }
        },
        "post_delay": 1000,
        "next": [
            "建国-通用-筛选-重置层-成功变白重置成功_松手",
            "建国-通用-筛选-重置层-按住红色尝试变白"
        ]
    },
    "建国-通用-筛选-重置层-成功变白重置成功_松手": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    71,
                    568,
                    255,
                    94
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "lower": [
                    241,
                    237,
                    227
                ],
                "connected": true,
                "count": 8500
            }
        },
        "action": {
            "type": "TouchUp",
            "param": {}
        },
        "post_delay": 1000,
        "next": [
            "建国-通用-筛选-重置层-检查是否松手成功",
            "建国-通用-筛选-重置层-成功变白重置成功_松手"
        ]
    },
    // 松手成功的确认：手指抬起 1 秒后按钮回弹成暗红，说明这次点击被游戏完整接收了。
    // 还是白的 = 没松开，回上层重扫时会再走一次「松手」补一次 TouchUp。
    "建国-通用-筛选-重置层-检查是否松手成功": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    71,
                    568,
                    255,
                    94
                ],
                "upper": [
                    165,
                    39,
                    72
                ],
                "lower": [
                    75,
                    8,
                    40
                ],
                "connected": true,
                "count": 8500
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "重置成功"
        },
        "next": [
            "建国-通用-筛选-筛选大类管理层"
        ]
    },
    "建国-通用-筛选-筛选大类管理层": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    556,
                    54,
                    162,
                    83
                ],
                "template": [
                    "通用/建国/兴建/筛选界面.png"
                ],
                "threshold": 0.85
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "将根据选择判定所需筛选的大类"
        },
        "next": [
            "建国-通用-筛选-地区筛选-开始层",
            "建国-通用-筛选-类别筛选-开始层",
            "建国-通用-筛选-时序筛选-开始层",
            // 每个段的「筛选完了」都会回到这里，靠各段开始层的 max_hit 依次轮转；
            // 三段都跑完（或被 option 禁用）后落到这里收尾。
            "建国-通用-筛选-筛选完了-通知层"
        ]
    },
    // ===== 结束层 =====
    // 三段筛完后的收尾：面板还开着就点「確定」关掉。
    "建国-通用-筛选-筛选完了-通知层": {
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Recognition.Succeeded": "筛选完毕,将关闭筛选面板"
        },
        "next": [
            "建国-通用-筛选-筛选完了-开始关闭筛选面板"
        ]
    },
    "建国-通用-筛选-筛选完了-开始关闭筛选面板": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    556,
                    54,
                    162,
                    83
                ],
                "template": [
                    "通用/建国/兴建/筛选界面.png"
                ],
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    674,
                    589,
                    199,
                    54
                ]
            }
        },
        "post_delay": 500,
        "next": [
            "建国-通用-筛选-结束层"
        ]
    },
    // 判据是「已回到提升界面、筛选入口按钮恢复普通态」，不是 ON 态。
    "建国-通用-筛选-结束层": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1118,
                    65,
                    126,
                    111
                ],
                "template": [
                    "通用/建国/提升/筛选入口.png",
                    "通用/建国/提升/已筛选.png"
                ],
                "threshold": 0.85
            }
        },
        "next": [
            "建国-通用-筛选-通知层"
        ]
    },
    // 通知层：整条链唯一一次「筛选已完成」播报。
    // 结束层是链尾且只有这一个 next，执行完就逐层返回，不会再回来，所以不需要 max_hit。
    "建国-通用-筛选-通知层": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": "DirectHit",
        "focus": "筛选已完成"
    }
}
